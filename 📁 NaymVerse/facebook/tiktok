shared-assets/css/style.css
body {
    font-family: Arial, sans-serif;
    background-color: #fafafa;
    margin: 0;
    padding: 0;
    text-align: center;
}

header {
    padding: 15px;
    color: white;
}

header.instagram { background: #e1306c; }
header.facebook { background: #1877f2; }
header.tiktok    { background: #010101; }

.container {
    margin: 30px auto;
    max-width: 600px;
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    text-align: center;
}

a.btn {
    display: inline-block;
    margin: 10px;
    padding: 10px 20px;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    transition: 0.3s;
}

a.btn.instagram { background: #e1306c; }
a.btn.instagram:hover { background: #c12759; }

a.btn.facebook { background: #1877f2; }
a.btn.facebook:hover { background: #145dbf; }

a.btn.tiktok { background: #010101; }
a.btn.tiktok:hover { background: #333; }

footer { margin-top: 20px; }
